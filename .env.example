DISCORD_TOKEN=

# OpenAI-compatible chat-completions endpoint (full URL) and model name
AI_API_URL=https://api.example.com/v1/chat/completions
AI_MODEL=your-model-name
AI_API_KEY=
AI_API_KEY_HEADER=Authorization
AI_API_KEY_PREFIX=Bearer
AI_EXTRA_HEADERS_JSON={}
AI_ALLOW_INSECURE_HTTP=false
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=60
AI_MAX_RETRIES=3
AI_MAX_RESPONSE_BYTES=2000000
AI_REQUESTS_PER_MINUTE=60
AI_SEND_IMAGE_URLS=true
AI_SEND_FILE_URLS=false

AUTHORIZED_USER_ID=0

MESSAGE_LOG_CHANNEL_ID=0
BOT_LOG_CHANNEL_ID=0
LOG_MESSAGE_CONTENT=false

MESSAGE_QUOTA=1000
MEMORY_RETENTION_DAYS=30
DATA_DIR=data
PERSONALITY_FILE=config/personality.md
BOT_TRIGGER_NAMES=Disturpe,Disturpe AI,Disturpe AI Chatbot
BOT_TIMEZONE=UTC
